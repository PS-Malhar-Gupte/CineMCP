# CineMCP API Keys Configuration
# Copy this file to .env and fill in your actual API keys

# OMDb API Key (get free key at https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=your_omdb_api_key_here

# TMDb API Key (get free key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# LLM Provider Configuration (optional - defaults to local Ollama)
# 
# For OpenRouter (https://openrouter.ai):
#   1. Sign up and get API key from https://openrouter.ai/keys
#   2. Set these variables:
#      OPENAI_API_KEY=your_openrouter_api_key_here
#      OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   3. Update MODEL_NAME in agent/config.py (e.g., "deepseek/deepseek-chat")
#
# For OpenAI:
#   1. Get API key from https://platform.openai.com/api-keys
#   2. Set: OPENAI_API_KEY=your_openai_api_key_here
#   3. Update MODEL_NAME in agent/config.py (e.g., "gpt-4o-mini")
#
# For Groq (https://groq.com):
#   1. Sign up and get API key from https://console.groq.com/keys
#   2. Set these variables:
#      OPENAI_API_KEY=your_groq_api_key_here
#      OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   3. Update MODEL_NAME in agent/config.py (e.g., "openai/gpt-oss-120b")
#
# For local Ollama:
#   - Leave OPENAI_API_KEY unset
#   - Make sure Ollama is running: ollama serve
#   - Set MODEL_NAME in agent/config.py (e.g., "mistral:7b")

# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

