# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Test files (manual/ad-hoc debug scripts at the project root - NOT the
# real automated suite in tests/, which is explicitly un-ignored below)
test_*.py
*_test.py
run_test_*.py
*_evidence.txt
*_template.txt
smoke_test_*.txt
TESTING_*.md
TEST_*.md
MANUAL_*.md
TASK_*_SUMMARY.md

# The tests/ directory holds real unittest suites (test_phase1.py,
# test_memory_and_conversation.py) - without this negation, the test_*.py
# pattern above would silently exclude them from every commit.
!tests/*.py

# OS
.DS_Store
Thumbs.db
*.bak
*.tmp

# Logs
*.log
logs/

